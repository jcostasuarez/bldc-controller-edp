#include "drv8301.h"

void drv8301_init(void) {
	// Disable OC (OverCurrent protection)
	uint16_t id = 0;
	id = drv8301_read_reg(1);

	if (id == 0) {
		// Entering here is an error, SPI is not working
		printf(">>> Error: Couldn't read the SPI ID.");
	}
	drv8301_write_reg(2, 0x0430);
	drv8301_write_reg(2, 0x0430);

	drv8301_set_current_amp_gain(20);
}

void drv8301_write_reg(int reg, int data) {
	uint16_t out = 0;

	out |= (reg & 0x0F) << 11;
	out |= data & 0x7FF;

	HAL_SPI_Transmit(hspi3, &out, 1, 10000);
}

uint16_t drv8301_read_reg(int reg) {
	uint16_t in = 0;
	HAL_SPI_Receive(hspi3, &in, 1, 10000);
	return in;
}
